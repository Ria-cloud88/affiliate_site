---
import { SITE_TITLE } from '../consts';
---

<header>
  <div class="header-inner">
    <a href="/" class="logo">
      <span class="logo-main">AIツール・副業</span>
      <span class="logo-sub">完全ガイド</span>
    </a>
    <nav id="desktop-nav">
      <a href="/">ホーム</a>
      <a href="/blog">ブログ一覧</a>
      <a href="/blog?genre=AIツール">AIツール</a>
      <a href="/blog?genre=副業">副業</a>
      <a href="/blog?genre=ガジェット">ガジェット</a>
      <a href="/blog?genre=生活改善">生活改善</a>
    </nav>
    <button class="mobile-menu-btn" aria-label="メニュー" aria-expanded="false">
      <span></span>
      <span></span>
      <span></span>
    </button>
  </div>
  <nav id="mobile-menu" class="mobile-menu">
    <a href="/">ホーム</a>
    <a href="/blog">ブログ一覧</a>
    <a href="/blog?genre=AIツール">AIツール</a>
    <a href="/blog?genre=副業">副業</a>
    <a href="/blog?genre=ガジェット">ガジェット</a>
    <a href="/blog?genre=生活改善">生活改善</a>
  </nav>
</header>

<style>
  header {
    background: white;
    border-bottom: 3px solid #1a2b5f;
    box-shadow: 0 2px 8px rgba(0,0,0,0.08);
    position: sticky;
    top: 0;
    z-index: 200;
  }

  .header-inner {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 16px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 60px;
  }

  .logo {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    line-height: 1.2;
  }

  .logo-main {
    font-size: 1.1em;
    font-weight: 900;
    color: #1a2b5f;
    letter-spacing: -0.5px;
  }

  .logo-sub {
    font-size: 0.7em;
    color: #1a56db;
    font-weight: bold;
  }

  #desktop-nav {
    display: flex;
    gap: 4px;
  }

  #desktop-nav a {
    padding: 6px 12px;
    color: #333;
    font-size: 0.85em;
    text-decoration: none;
    border-radius: 4px;
    transition: background 0.15s;
  }

  #desktop-nav a:hover {
    background: #f0f4ff;
    color: #1a56db;
    text-decoration: none;
  }

  /* Mobile menu button */
  .mobile-menu-btn {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 8px;
  }

  .mobile-menu-btn span {
    display: block;
    width: 24px;
    height: 2px;
    background: #1a2b5f;
    border-radius: 1px;
    transition: all 0.3s;
  }

  .mobile-menu-btn[aria-expanded="true"] span:nth-child(1) {
    transform: rotate(45deg) translate(8px, 8px);
  }

  .mobile-menu-btn[aria-expanded="true"] span:nth-child(2) {
    opacity: 0;
  }

  .mobile-menu-btn[aria-expanded="true"] span:nth-child(3) {
    transform: rotate(-45deg) translate(7px, -7px);
  }

  /* Mobile menu */
  .mobile-menu {
    display: none;
    flex-direction: column;
    gap: 0;
    position: fixed;
    top: 60px;
    left: 0;
    width: 100%;
    background: white;
    border-bottom: 3px solid #1a2b5f;
    z-index: 150;
    box-shadow: 0 2px 8px rgba(0,0,0,0.08);
  }

  .mobile-menu.open {
    display: flex;
  }

  .mobile-menu a {
    padding: 14px 16px;
    color: #333;
    font-size: 0.95em;
    text-decoration: none;
    border-bottom: 1px solid #f0f4ff;
    transition: background 0.15s;
  }

  .mobile-menu a:last-child {
    border-bottom: none;
  }

  .mobile-menu a:hover {
    background: #f0f4ff;
    color: #1a56db;
  }

  @media (max-width: 600px) {
    .mobile-menu-btn {
      display: flex;
    }

    #desktop-nav {
      display: none;
    }
  }
</style>

<script>
  const btn = document.querySelector('.mobile-menu-btn') as HTMLButtonElement;
  const menu = document.getElementById('mobile-menu') as HTMLElement;
  const menuLinks = menu?.querySelectorAll('a') || [];

  btn?.addEventListener('click', () => {
    const isOpen = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', String(!isOpen));
    menu?.classList.toggle('open');
  });

  menuLinks.forEach(link => {
    link.addEventListener('click', () => {
      btn.setAttribute('aria-expanded', 'false');
      menu?.classList.remove('open');
    });
  });
</script>
